// The shop as it was first deployed, before orders could be placed, so the history of dev has a
// deploy before the one koldstart.pkl makes.
amends "koldstart.pkl"

import "@koldstart/kdst.pkl"

functions {
  ["api"] {
    memory = 128
    events = new {
      kdst.get("/products")
      kdst.get("/orders/{id}")
    }
  }
}

outputs {
  ["features"] = #"{"checkout":false,"reviews":false,"currencies":["EUR"]}"#
}
