// The change the recording plans: more memory and a log level for the api, a route for one
// product, bigger batches for the worker and a longer visibility timeout for its queue.
amends "koldstart.pkl"

import "../../pkl/kdst.pkl"

functions {
  ["api"] {
    memory = 512
    timeout = 15.s
    environment {
      ["LOG_LEVEL"] = "debug"
    }
    events {
      new kdst.HttpRoute { method = "GET"; path = "/products/{id}" }
    }
  }
  ["worker"] {
    events = new {
      new kdst.Queue { queue = "arn:aws:sqs:eu-west-1:000000000000:shop-\(kdst.stage)-jobs"; batchSize = 25 }
    }
  }
}

resources {
  ["jobs"] {
    properties {
      VisibilityTimeout = 120
    }
  }
}
