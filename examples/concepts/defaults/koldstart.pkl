amends "@koldstart/Project.pkl"

import "@koldstart/kdst.pkl"

app = "defaults"
region = "eu-west-1"

functions {
  // what every function gets, unless it sets its own. default is not a function: each entry
  // beside it amends it
  default {
    memory = 256
    timeout = 10.s
    logRetention = 30
    logFormat = "json"
    applicationLogLevel = "INFO"
    systemLogLevel = "WARN"
    tracing = true
  }

  ["lookup"] {}

  ["export"] {
    // an export reads a lot and takes its time, so it sets its own memory and timeout and keeps
    // the rest
    memory = 1024
    timeout = 2.min
  }
}
