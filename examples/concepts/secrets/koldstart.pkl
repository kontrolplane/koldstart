amends "@koldstart/Project.pkl"

import "@koldstart/kdst.pkl"

app = "secrets"
region = "eu-west-1"

functions {
  ["payments"] {
    memory = 256
    environment {
      // read while deploying, from ssm under the app and stage: /secrets/<stage>/provider-key
      ["PROVIDER_KEY"] = kdst.param("provider-key")
      // one key of a json secret of secrets manager, also under the app and stage:
      // secrets/<stage>/database
      ["DATABASE_PASSWORD"] = kdst.secret("database").field("password")
      // by its full name, shared by every app and stage
      ["ERROR_REPORTING_URL"] = kdst.ssm("/shared/error-reporting-url")
      // read by the function itself: the variable holds the parameter's arn, the role may read
      // it, and the value is in no configuration
      ["WEBHOOK_SECRET"] = kdst.param("webhook-secret").readAtRuntime()
      // a key of a secret every stage shares, read by the function: the variable holds the
      // secret's arn, and PARTNER_TOKEN_KEY says which key
      ["PARTNER_TOKEN"] = kdst.secretsmanager("shared/partner").field("token").readAtRuntime()
    }
  }
}
