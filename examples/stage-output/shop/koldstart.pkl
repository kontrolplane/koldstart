amends "@koldstart/Project.pkl"

import "@koldstart/kdst.pkl"

app = "shop"
region = "eu-west-1"

functions {
  ["checkout"] {
    memory = 256
    timeout = 10.s
    environment {
      // the url of the payments app's http api on the stage of the same name, read from its state
      ["PAYMENTS_URL"] = kdst.stageOutput("payments", kdst.stage, "httpApiUrl")
    }
    events {
      kdst.post("/checkout")
    }
  }
}
