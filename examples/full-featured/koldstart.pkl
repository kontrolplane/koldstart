amends "@koldstart/Project.pkl"

import "@koldstart/kdst.pkl"

app = "shop"
region = "eu-west-1"

tags {
  ["team"] = "checkout"
}

functions {
  ["api"] {
    memory = if (kdst.stage == "prod") 1024 else 256
    timeout = 10.s
    environment {
      // /shop/<stage>/api-key in ssm parameter store
      ["API_KEY"] = kdst.param("api-key")
    }
    link {
      ["orders"] = "read"
      ["jobs"] = "readwrite"
    }
    events {
      new kdst.HttpRoute { method = "GET"; path = "/orders/{id}" }
      new kdst.HttpRoute { method = "POST"; path = "/orders" }
    }
  }

  ["worker"] {
    timeout = 30.s
    link {
      ["orders"] = "readwrite"
    }
    events {
      new kdst.Queue { queue = kdst.ref("jobs", "Arn"); batchSize = 10 }
    }
  }

  ["report"] {
    link {
      ["orders"] = "read"
    }
    events {
      new kdst.Schedule { expression = "rate(1 hour)"; enabled = kdst.stage == "prod" }
    }
  }
}

resources {
  ["orders"] {
    type = "AWS::DynamoDB::Table"
    properties {
      BillingMode = "PAY_PER_REQUEST"
      AttributeDefinitions { new { AttributeName = "id"; AttributeType = "S" } }
      KeySchema { new { AttributeName = "id"; KeyType = "HASH" } }
    }
  }

  ["jobs"] {
    type = "AWS::SQS::Queue"
    properties {
      VisibilityTimeout = 60
    }
  }
}

outputs {
  ["ordersTable"] = kdst.ref("orders", "TableName")
}
