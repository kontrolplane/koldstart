amends "@koldstart/Project.pkl"

import "@koldstart/kdst.pkl"

app = "shop"
region = "eu-west-1"

tags {
  ["team"] = "checkout"
}

functions {
  // what every function gets, unless it sets its own
  default {
    memory = 512
    logRetention = 14
  }

  ["api"] {
    memory = if (kdst.stage == "prod") 1024 else 256
    timeout = 10.s
    environment {
      // /shop/<stage>/api-key in ssm parameter store
      ["API_KEY"] = kdst.param("api-key")
    }
    link {
      ["orders"] = "read"
      ["jobs"] = "readwrite"
    }
    events {
      kdst.get("/orders/{id}")
      kdst.post("/orders")
    }
  }

  ["worker"] {
    timeout = 30.s
    link {
      ["orders"] = "readwrite"
    }
    events {
      kdst.fromQueue("jobs")
    }
  }

  ["report"] {
    link {
      ["orders"] = "read"
    }
    events {
      (kdst.schedule("rate(1 hour)")) { enabled = kdst.stage == "prod" }
    }
  }
}

resources {
  ["orders"] = kdst.table("id")

  ["jobs"] = (kdst.queue()) {
    properties {
      VisibilityTimeout = 60
    }
  }
}

outputs {
  ["ordersTable"] = kdst.ref("orders", "TableName")
}
