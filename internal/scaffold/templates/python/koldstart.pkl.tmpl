amends "@koldstart/Project.pkl"

import "@koldstart/kdst.pkl"

app = "{{.App}}"
region = "{{.Region}}"

functions {
  ["api"] {
    memory = 256
    // a secret of the stage, /{{.App}}/<stage>/api-key in ssm parameter store:
    // environment { ["API_KEY"] = kdst.param("api-key") }
    events {
      new kdst.HttpRoute { method = "GET"; path = "/hello" }
    }
  }
}
