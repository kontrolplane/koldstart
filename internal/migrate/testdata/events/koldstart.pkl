// Converted from serverless.yml by kdst migrate. Look for TODO: what it could not convert.
amends "package://github.com/kontrolplane/koldstart/releases/download/v0.1.0/koldstart@0.1.0#/Project.pkl"

import "package://github.com/kontrolplane/koldstart/releases/download/v0.1.0/koldstart@0.1.0#/kdst.pkl"

app = "notifier"
region = "us-east-1"

http {
  cors = new { origins { "*" } }
  authorizers {
    ["users"] = new kdst.JwtAuthorizer {
      issuer = "https://auth.example.com"
      audience {
        "notifier"
      }
    }
  }
}

websocket { routeSelection = "$request.body.type" }

functions {
  ["realtime"] {
    runtime = "nodejs22.x"
    handler = "src/realtime.handler"
    events {
      new kdst.WebSocketRoute { route = "$default" }
      new kdst.WebSocketRoute { route = "$disconnect" }
      new kdst.WebSocketRoute { route = "chat" }
    }
  }
  ["onOrder"] {
    runtime = "nodejs22.x"
    handler = "src/orders.handler"
    events {
      new kdst.EventRule {
        pattern = new Dynamic {
          source {
            "orders.service"
          }
          ["detail-type"] {
            "OrderPlaced"
          }
        }
        bus = "orders"
        input = "{\"kind\":\"order\"}"
      }
      // TODO: an eventBridge event without a pattern, such as a schedule: use kdst.Schedule
      // was: {schedule: rate(1 hour)}
    }
  }
  ["legacy"] {
    runtime = "nodejs22.x"
    handler = "src/legacy.handler"
    events {
      new kdst.LoadBalancer {
        listener = "arn:aws:elasticloadbalancing:us-east-1:123456789012:listener/app/legacy/50dc6c495c0c9188/f2f7dc8efc522ab2"
        priority = 10
        paths {
          "/legacy/*"
        }
        methods {
          "GET"
          "POST"
        }
        // TODO: a condition on the header has no equivalent yet
        // was: {name: x-version, values: ["2"]}
        multiValueHeaders = true
      }
    }
  }
  ["api"] {
    runtime = "nodejs22.x"
    handler = "src/api.handler"
    url = new {
      auth = "iam"
      cors = new {
        origins {
          "https://example.com"
        }
        maxAge = 300.s
      }
    }
    events {
      new kdst.HttpRoute {
        method = "GET"
        path = "/me"
        scopes {
          "profile"
        }
        authorizer = "users"
      }
      new kdst.HttpRoute {
        method = "ANY"
        path = "$default"
      }
      // TODO: this was a route of the rest api (http); it is one of the http api (httpApi) now.
      new kdst.HttpRoute {
        method = "GET"
        path = "/legacy/{id}"
      }
    }
  }
  ["cron"] {
    runtime = "nodejs22.x"
    handler = "src/cron.handler"
    events {
      new kdst.Schedule {
        expression = "rate(5 minutes)"
      }
      new kdst.Schedule {
        expression = "cron(0 9 ? * MON-FRI *)"
        enabled = false
        input = "{\"kind\":\"report\"}"
      }
    }
  }
  ["listener"] {
    runtime = "nodejs22.x"
    handler = "src/listener.handler"
    events {
      new kdst.Topic {
        topic = kdst.ref("alerts", "TopicArn")
      }
      new kdst.Topic {
        topic = "arn:aws:sns:us-east-1:123456789012:billing"
        filterPolicy = "{\"kind\":[\"invoice\"]}"
      }
      new kdst.Bucket {
        bucket = kdst.ref("notifier-uploads", "BucketName")
        events { "s3:ObjectCreated:*" }
        prefix = "incoming/"
        suffix = ".png"
      }
      new kdst.Bucket {
        bucket = "existing-archive"
      }
      new kdst.Stream {
        stream = "arn:aws:dynamodb:us-east-1:123456789012:table/events/stream/2026-01-01T00:00:00.000"
        startingPosition = "TRIM_HORIZON"
        maximumBatchingWindow = 5.s
        reportBatchItemFailures = false
      }
      new kdst.WebSocketRoute { route = "$connect" }
      new kdst.EventRule {
        pattern = new Dynamic {
          source {
            "aws.ec2"
          }
        }
      }
    }
  }
}

resources {
  // serverless.yml made this for an event of a function.
  ["alerts"] {
    type = "AWS::SNS::Topic"
    properties { TopicName = "alerts" }
  }
  // serverless.yml made this for an event of a function.
  ["notifier-uploads"] {
    type = "AWS::S3::Bucket"
    properties { BucketName = "notifier-uploads" }
  }
}
