// Converted from serverless.yml by kdst migrate.
// A TODO comment marks each thing it could not convert, or converted differently.

amends "@koldstart/Project.pkl"

import "@koldstart/kdst.pkl"

app = "notifier"
region = "us-east-1"

http {
  cors = new { origins { "*" } }
  authorizers {
    ["users"] = new kdst.JwtAuthorizer {
      issuer = "https://auth.example.com"
      audience {
        "notifier"
      }
    }
  }
}

websocket { routeSelection = "$request.body.type" }

functions {
  ["realtime"] {
    runtime = "nodejs22.x"
    handler = "src/realtime.handler"
    events {
      kdst.fromWebSocket("$default")
      kdst.fromWebSocket("$disconnect")
      kdst.fromWebSocket("chat")
    }
  }
  ["onOrder"] {
    runtime = "nodejs22.x"
    handler = "src/orders.handler"
    events {
      new kdst.EventRule {
        pattern = new Dynamic {
          source {
            "orders.service"
          }
          ["detail-type"] {
            "OrderPlaced"
          }
        }
        bus = "orders"
        input = "{\"kind\":\"order\"}"
      }
      // TODO: an EventRule needs a pattern: write a schedule as kdst.schedule("rate(...)")
      // was: {schedule: rate(1 hour)}
    }
  }
  ["legacy"] {
    runtime = "nodejs22.x"
    handler = "src/legacy.handler"
    events {
      new kdst.LoadBalancer {
        listener = "arn:aws:elasticloadbalancing:us-east-1:123456789012:listener/app/legacy/50dc6c495c0c9188/f2f7dc8efc522ab2"
        priority = 10
        paths {
          "/legacy/*"
        }
        methods {
          "GET"
          "POST"
        }
        headers {
          ["x-version"] {
            "2"
          }
        }
        multiValueHeaders = true
      }
    }
  }
  ["api"] {
    runtime = "nodejs22.x"
    handler = "src/api.handler"
    url = new {
      auth = "iam"
      cors = new {
        origins {
          "https://example.com"
        }
        maxAge = 300.s
      }
    }
    events {
      (kdst.get("/me")) {
        authorizer = "users"
        scopes {
          "profile"
        }
      }
      kdst.any("$default")
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      kdst.get("/legacy/{id}")
    }
  }
  ["cron"] {
    runtime = "nodejs22.x"
    handler = "src/cron.handler"
    events {
      kdst.schedule("rate(5 minutes)")
      (kdst.schedule("cron(0 9 ? * MON-FRI *)")) {
        enabled = false
        input = "{\"kind\":\"report\"}"
      }
    }
  }
  ["listener"] {
    runtime = "nodejs22.x"
    handler = "src/listener.handler"
    events {
      kdst.fromTopic("alerts")
      (kdst.fromTopic("arn:aws:sns:us-east-1:123456789012:billing")) {
        filterPolicy = "{\"kind\":[\"invoice\"]}"
      }
      (kdst.fromBucket("notifier-uploads")) {
        events { "s3:ObjectCreated:*" }
        prefix = "incoming/"
        suffix = ".png"
      }
      new kdst.Bucket {
        bucket = "existing-archive"
      }
      (kdst.fromTableStream("arn:aws:dynamodb:us-east-1:123456789012:table/events/stream/2026-01-01T00:00:00.000")) {
        startingPosition = "TRIM_HORIZON"
        maximumBatchingWindow = 5.s
        reportBatchItemFailures = false
      }
      kdst.fromWebSocket("$connect")
      new kdst.EventRule {
        pattern = new Dynamic {
          source {
            "aws.ec2"
          }
        }
      }
    }
  }
}

resources {
  // serverless.yml made this topic for functions.listener.events[0].
  ["alerts"] = (kdst.topic()) {
    properties { TopicName = "alerts" }
  }
  // serverless.yml made this bucket for functions.listener.events[2].
  ["notifier-uploads"] {
    type = "AWS::S3::Bucket"
    properties { BucketName = "notifier-uploads" }
  }
}
