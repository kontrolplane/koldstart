amends "@koldstart/Project.pkl"

import "@koldstart/kdst.pkl"

app = "ledger"
region = "eu-west-1"

http {
  authorizers {
    ["auth"] = new kdst.LambdaAuthorizer {
      functionName = "auth"
      identity {
        "$request.header.Authorization"
      }
    }
    // TODO: the authorizer is one of the http api now: it gets the event of payload 2.0, with identitySource and routeArn in place of authorizationToken and methodArn, and returns { isAuthorized, context } in place of an iam policy
    ["auth-2"] = new kdst.LambdaAuthorizer {
      functionName = "auth"
      identity {
        "$request.header.Authorization"
      }
      ttl = 300.s
    }
    // TODO: the authorizer is one of the http api now: it gets the event of payload 2.0, with identitySource and routeArn in place of authorizationToken and methodArn, and returns { isAuthorized, context } in place of an iam policy
    ["requestAuth"] = new kdst.LambdaAuthorizer {
      functionName = "requestAuth"
      identity {
        "$request.header.X-Token"
        "$request.querystring.token"
      }
      ttl = 60.s
    }
    // TODO: the authorizer is one of the http api now: it gets the event of payload 2.0, with identitySource and routeArn in place of authorizationToken and methodArn, and returns { isAuthorized, context } in place of an iam policy
    // TODO: the http api refuses a request without an Authorization header before it calls the authorizer: set identity to what every request has
    ["requestAuth-2"] = new kdst.LambdaAuthorizer {
      functionName = "requestAuth"
    }
    // TODO: the authorizer is one of the http api now: it gets the event of payload 2.0, with identitySource and routeArn in place of authorizationToken and methodArn, and returns { isAuthorized, context } in place of an iam policy
    // TODO: the http api has no identityValidationExpression: check the token against ^Bearer [-0-9a-zA-Z._]+$ in the authorizer
    ["auth-3"] = new kdst.LambdaAuthorizer {
      functionName = "auth"
      identity {
        "$request.header.Authorization"
      }
      ttl = 300.s
    }
    // TODO: set audience to the ids of the user pool's app clients: the http api takes a token only when its aud or client_id is one of them, where the rest api took one of any client of the pool
    // TODO: the function finds the token's claims in requestContext.authorizer.jwt.claims now, not requestContext.authorizer.claims
    ["cognito"] = new kdst.JwtAuthorizer {
      issuer = "https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_Ab12Cd34"
      audience { "<app client id>" }
    }
  }
}

functions {
  ["auth"] {
    runtime = "nodejs22.x"
    handler = "src/auth.handler"
  }
  ["requestAuth"] {
    runtime = "nodejs22.x"
    handler = "src/request-auth.handler"
  }
  ["api"] {
    runtime = "nodejs22.x"
    handler = "src/api.handler"
    events {
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      (kdst.get("/accounts")) {
        authorizer = "auth-2"
      }
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      (kdst.post("/accounts")) {
        authorizer = "auth-2"
      }
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      (kdst.get("/accounts/{id}")) {
        authorizer = "requestAuth"
      }
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      (kdst.del("/accounts/{id}")) {
        authorizer = "requestAuth-2"
      }
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      (kdst.put("/accounts/{id}")) {
        authorizer = "auth-3"
      }
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      (kdst.get("/internal")) {
        iam = true
      }
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      (kdst.post("/internal")) {
        iam = true
      }
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      // TODO: the http api hands the function every claim of the token
      (kdst.get("/me")) {
        authorizer = "cognito"
        scopes {
          "ledger/read"
        }
      }
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      // TODO: the route is open now, as a jwt authorizer takes the issuer of a user pool as a string, https://cognito-idp.<region>.amazonaws.com/<pool id>, not a ref: give it an authorizer of http.authorizers, or iam = true
      // was: {name: users, type: COGNITO_USER_POOLS, arn: !GetAtt UserPool.Arn}
      kdst.patch("/me")
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      // TODO: the route is open now, as it names an authorizer of the rest api by its id, which the http api cannot use: give it an authorizer of http.authorizers, or iam = true
      // was: {type: COGNITO_USER_POOLS, authorizerId: !Ref ApiGatewayAuthorizer}
      kdst.get("/shared")
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      // TODO: the route is open now, as a lambda authorizer is a function of the project, and arn:aws:lambda:eu-west-1:123456789012:function:shared-auth is not one: give it an authorizer of http.authorizers, or iam = true
      // was: arn:aws:lambda:eu-west-1:123456789012:function:shared-auth
      kdst.get("/external")
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      // TODO: the route is open now, as it took only requests with an api key, which an http api has none of: give it an authorizer of http.authorizers, or iam = true
      kdst.get("/partners")
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      // TODO: an http api has no api keys: the route takes requests without one now, which its authorizer still checks
      (kdst.post("/partners")) {
        iam = true
      }
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      // TODO: the http api checks no parameters or bodies: check them in the function
      // was: {parameters: {querystrings: {dryRun: false}}, schemas: {application/json: {type: object}}}
      // TODO: an http api has one cors for all its routes: set it in http.cors
      // was: true
      // TODO: the http api waits for the function, as it has no async invocation: hand slow work to a queue
      kdst.post("/orders")
      // TODO: a route of the rest api is one of the http api now: check the function takes the event of payload 2.0, not 1.0, and does without request validation, api keys and usage plans
      // TODO: the function gets the request and returns the response as the proxy integration does, as the http api has no lambda integration: its request templates and response are gone
      kdst.post("/legacy")
      // TODO: an http api of koldstart routes to its function alone: it has no mock integration
      // was: {method: get, path: mock, integration: mock}
    }
  }
}

resources {
  ["UserPool"] {
    type = "AWS::Cognito::UserPool"
  }
}
