// Converted from serverless.yml by kdst migrate. Look for TODO: what it could not convert.
amends "package://github.com/kontrolplane/koldstart/releases/download/v0.1.0/koldstart@0.1.0#/Project.pkl"

import "package://github.com/kontrolplane/koldstart/releases/download/v0.1.0/koldstart@0.1.0#/kdst.pkl"

app = "legacy"
region = "eu-central-1"

functions {
  ["scraper"] {
    runtime = "python3.12"
    handler = "handler.main"
    environment {
      ["REGION"] = module.region
      ["BUCKET"] = "\(module.app)-\(kdst.stage)-files"
      // TODO: ${file(./config.json):key}: there is no ./config.json next to serverless.yml
      // was: ${file(./config.json):key}
      ["SHARED"] = kdst.stageOutput("shared", "prod", "QueueUrl")
      ["LOG_LEVEL"] = read?("env:LOG_LEVEL") ?? "info"
    }
  }
  ["reports"] {
    runtime = "python3.12"
    handler = "src/reports.build"
    environment {
      ["REGION"] = module.region
      ["BUCKET"] = "\(module.app)-\(kdst.stage)-files"
      // TODO: ${file(./config.json):key}: there is no ./config.json next to serverless.yml
      // was: ${file(./config.json):key}
      ["SHARED"] = kdst.stageOutput("shared", "prod", "QueueUrl")
      ["LOG_LEVEL"] = read?("env:LOG_LEVEL") ?? "info"
    }
    layers {
      "arn:aws:lambda:eu-central-1:123456789012:layer:pandas:4"
    }
  }
  ["thumbs"] {
    image {
      context = "thumbnailer"
      dockerfile = "thumbnailer/Dockerfile.lambda"
      buildArgs {
        ["SIZE"] = "256"
      }
      command {
        "app.handler"
      }
    }
    environment {
      ["REGION"] = module.region
      ["BUCKET"] = "\(module.app)-\(kdst.stage)-files"
      // TODO: ${file(./config.json):key}: there is no ./config.json next to serverless.yml
      // was: ${file(./config.json):key}
      ["SHARED"] = kdst.stageOutput("shared", "prod", "QueueUrl")
      ["LOG_LEVEL"] = read?("env:LOG_LEVEL") ?? "info"
    }
  }
  // TODO: image runs a prebuilt image, which koldstart does not take: build it from its dockerfile. was: 123456789012.dkr.ecr.eu-central-1.amazonaws.com/legacy:latest
  ["worker"] {
    runtime = "provided.al2023"
    // TODO: the package to build, such as ./cmd/worker; serverless.yml had "bootstrap".
    handler = "./cmd/worker"
    environment {
      ["REGION"] = module.region
      ["BUCKET"] = "\(module.app)-\(kdst.stage)-files"
      // TODO: ${file(./config.json):key}: there is no ./config.json next to serverless.yml
      // was: ${file(./config.json):key}
      ["SHARED"] = kdst.stageOutput("shared", "prod", "QueueUrl")
      ["LOG_LEVEL"] = read?("env:LOG_LEVEL") ?? "info"
    }
    // TODO: a go function has no layers: build what they hold into the binary
    // was: ['arn:aws:lambda:eu-central-1:123456789012:layer:tools:1']
  }
  ["old-api"] {
    runtime = "nodejs22.x"
    handler = "src/api.handler"
    reservedConcurrency = 5
    environment {
      ["REGION"] = module.region
      ["BUCKET"] = "\(module.app)-\(kdst.stage)-files"
      // TODO: ${file(./config.json):key}: there is no ./config.json next to serverless.yml
      // was: ${file(./config.json):key}
      ["SHARED"] = kdst.stageOutput("shared", "prod", "QueueUrl")
      ["LOG_LEVEL"] = read?("env:LOG_LEVEL") ?? "info"
      ["TOPIC"] = kdst.join(List("arn:aws:sns:\(module.region):", kdst.accountId, ":alerts"))
    }
  }
}

resources {
  ["Files"] {
    type = "AWS::S3::Bucket"
    deletionPolicy = "retain"
    properties {
      BucketName = "\(module.app)-\(kdst.stage)-files"
      Tags {
        new {
          Key = "aws:cloudformation:custom"
          Value = "yes"
        }
      }
    }
    // TODO: DependsOn has no equivalent. was: Seeder
  }
  // TODO: Custom::Seed is not an aws type cloud control creates
  // was: {Type: 'Custom::Seed', Properties: {ServiceToken: !GetAtt SeedLambdaFunction.Arn}}
}

outputs {
  ["FilesArn"] = kdst.ref("Files", "Arn")
  ["Joined"] = "a-b"
}
